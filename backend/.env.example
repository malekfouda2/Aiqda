NODE_ENV=development
PORT=3001
MONGODB_URI=mongodb://localhost:27017/aiqda
JWT_SECRET=your-secret-key
FRONTEND_URL=http://localhost:5000
TRUST_PROXY=1
REDIS_URL=redis://localhost:6379
AUTH_COOKIE_NAME=aiqda_auth
AUTH_COOKIE_SAME_SITE=lax
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_MAX_AGE_MS=604800000
DEVICE_COOKIE_NAME=aiqda_device
DEVICE_COOKIE_MAX_AGE_MS=31536000000
MAX_AUTH_DEVICES=2
AUTH_ACTIVE_SESSION_IDLE_TIMEOUT_MS=900000
APP_URL=http://localhost:3001
BACKEND_PUBLIC_URL=http://localhost:3001
EBAA_REVIEWER_NAME=Ebaa
EBAA_REVIEWER_EMAIL=ebaa@aiqda.com
EBAA_REVIEWER_PASSWORD=
LEGACY_LESSON_PUBLISH_BACKFILL_CUTOFF=2026-04-05T00:00:00.000Z
VIMEO_ACCESS_TOKEN=
# Comma-separated public website domains allowed to embed Vimeo videos in production, e.g. aiqda.pro,www.aiqda.pro
VIMEO_ALLOWED_EMBED_DOMAINS=
AUTO_SEED_DEMO_DATA=true
AUTO_SEED_CONSULTATIONS=true
ALLOW_PRODUCTION_AUTO_SEED=false
AUTH_REGISTER_RATE_LIMIT_MAX=5
AUTH_LOGIN_RATE_LIMIT_MAX=10
AUTH_SOCIAL_RATE_LIMIT_MAX=20
INVITE_ACCEPT_RATE_LIMIT_MAX=10
CONTACT_SUBMISSION_RATE_LIMIT_MAX=5
INSTRUCTOR_APPLICATION_RATE_LIMIT_MAX=5
STUDIO_APPLICATION_RATE_LIMIT_MAX=5

# SMTP email delivery (Zoho Mail example)
SMTP_HOST=smtppro.zoho.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=info@aiqda.pro
SMTP_PASS=your-zoho-app-password
EMAIL_FROM=Aiqda <info@aiqda.pro>
CONTACT_NOTIFICATION_TO=contact@aiqda.pro

# Tap subscription checkout
TAP_SECRET_KEY=
TAP_PUBLIC_KEY=
TAP_MERCHANT_ID=
TAP_CARD_SDK_URL=https://tap-sdks.b-cdn.net/card/1.0.2/index.js
TAP_APPLE_PAY_SDK_URL=https://tap-sdks.b-cdn.net/apple-pay/build-1.2.0/main.js
TAP_APPLE_PAY_CSS_URL=https://tap-sdks.b-cdn.net/apple-pay/build-1.2.0/main.css
TAP_APPLE_PAY_DOMAIN=
TAP_APPLE_PAY_ENVIRONMENT=development
SUBSCRIPTION_CURRENCY=SAR
SUBSCRIPTION_RENEWAL_WORKER_ENABLED=true
SUBSCRIPTION_RENEWAL_INTERVAL_MS=300000
SUBSCRIPTION_RENEWAL_BATCH_SIZE=20
SUBSCRIPTION_RENEWAL_GRACE_PERIOD_DAYS=7
SUBSCRIPTION_RENEWAL_MAX_RETRIES=3
SUBSCRIPTION_RENEWAL_RETRY_DELAYS_HOURS=12,36,72

# Social login
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
LINKEDIN_OAUTH_CLIENT_ID=
LINKEDIN_OAUTH_CLIENT_SECRET=

# Studio approval scheduling
STUDIO_APPLICATION_MEETING_URL=https://scheduler.example.com/aiqda/studio-intro
